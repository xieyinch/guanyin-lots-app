{
  "name": "观音灵签",
  "slug": "guanyin-lots-app",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/images/icon.png",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "space.manus.guanyin"
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#E6F4FE",
      "foregroundImage": "./assets/images/android-icon-foreground.png",
      "backgroundImage": "./assets/images/android-icon-background.png"
    },
    "edgeToEdgeEnabled": true,
    "package": "space.manus.guanyin",
    "minSdkVersion": 24
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    "expo-router",
    "expo-asset",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    ],
    [
      "expo-build-properties",
      {
        "android": {
          "buildArchs": ["arm64-v8a"],
          "minSdkVersion": 24
        }
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "eas": {
      "projectId": "guanyin-lots-app"
    }
  }
}
